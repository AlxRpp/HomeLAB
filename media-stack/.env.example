# Vorlage. Kopie als ".env" danebenlegen und ausfüllen.
#
# Die echte .env enthält den privaten WireGuard-Key und ist per
# .gitignore vom Repo ausgeschlossen. Sie gehört ins
# Passwortmanager-Backup — ein Restore ohne sie sieht erst mal aus,
# als hätte er geklappt.
# → 00-fundament.md, Abschnitt 6, "Schlüssel sind Teil des Backups"

# ---------------------------------------------------------------------
# Basis
# ---------------------------------------------------------------------
TZ=Europe/Berlin

# Unraid-Standard (nobody:users). NICHT 1000:1000 wie in der
# TechHut-Vorlage — die ist für Debian/Ubuntu geschrieben.
PUID=99
PGID=100

# ---------------------------------------------------------------------
# VPN — Variante ProtonVPN (gewählt)
# ---------------------------------------------------------------------
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard

# account.proton.me → VPN → WireGuard-Konfiguration
#   Plattform: GNU/Linux
#   VPN-Optionen: NAT-PMP (Port-Weiterleitung) AKTIVIEREN — hängt am
#   erzeugten Schlüssel, nachträglich nicht umschaltbar
#   Server im Generator ist egal, der Key gilt für alle
# Aus dem Ergebnis nur den Wert hinter "PrivateKey = " übernehmen.
WIREGUARD_PRIVATE_KEY=

# Gluetun holt den weitergeleiteten Port selbst per NAT-PMP.
VPN_PORT_FORWARDING=on

# Beschränkt die Serverauswahl auf P2P-fähige Server.
PORT_FORWARD_ONLY=on

# ---------------------------------------------------------------------
# VPN — Variante AirVPN (Alternative, dann obige Proton-Zeilen ersetzen)
# ---------------------------------------------------------------------
#VPN_SERVICE_PROVIDER=airvpn
#VPN_TYPE=wireguard
#WIREGUARD_PUBLIC_KEY=
#WIREGUARD_PRIVATE_KEY=
#WIREGUARD_PRESHARED_KEY=
#WIREGUARD_ADDRESSES=
# Fester Port aus dem AirVPN Client Area → Ports
#FIREWALL_VPN_INPUT_PORTS=

# ---------------------------------------------------------------------
# Gemeinsame VPN-Optionen
# ---------------------------------------------------------------------
# Serverwahl: erst setzen, wenn die Basis läuft. Zwei aktive Filter
# gleichzeitig sind der häufigste Grund für "gluetun findet keinen
# Server". Für Torrents üblich: Netherlands oder Switzerland.
#SERVER_COUNTRIES=Netherlands

# Gluetuns eingebauter DNS-Resolver (unbound) lässt seinen Cache über
# Wochen auf mehrere GB anwachsen. Auf einer 24/7-Kiste abschalten.
BLOCK_MALICIOUS=off

# Mehr Zeit für den Tunnelaufbau, bevor der Healthcheck zuschlägt.
HEALTH_VPN_DURATION_INITIAL=120s

# Bei ProtonVPN leer lassen — der Port ist dynamisch und kommt über
# VPN_PORT_FORWARDING. Nur bei AirVPN mit festem Port füllen.
FIREWALL_VPN_INPUT_PORTS=

# ---------------------------------------------------------------------
# Feste IPs im servarrnetwork
# ---------------------------------------------------------------------
SET_IP_GLUETUN=172.39.0.2
SET_IP_SONARR=172.39.0.3
SET_IP_RADARR=172.39.0.4
SET_IP_LIDARR=172.39.0.5
SET_IP_BAZARR=172.39.0.6
SET_IP_SEERR=172.39.0.7
SET_IP_JELLYFIN=172.39.0.8

# ---------------------------------------------------------------------
# Jellyfin
# ---------------------------------------------------------------------
# IP oder Hostname, unter dem Clients den Server erreichen.
JELLYFIN_URL=http://192.168.178.x:8096
