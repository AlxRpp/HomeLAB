# Vorlage. Kopie als ".env" neben die compose.yaml legen und ausfüllen.
# Die echte .env NIEMALS ins Git oder in eine Cloud — sie enthält
# den privaten WireGuard-Key.
#
# Diese Datei gehört ins Passwortmanager-Backup.
# → 00-fundament.md, Abschnitt 6, "Schlüssel sind Teil des Backups"

# ---------------------------------------------------------------------
# Basis
# ---------------------------------------------------------------------
TZ=Europe/Berlin

# Unraid-Standard: nobody:users. NICHT 1000:1000 wie im Original-Repo.
PUID=99
PGID=100

# ---------------------------------------------------------------------
# VPN
# ---------------------------------------------------------------------
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard

# --- Variante A: AirVPN (statischer Port aus dem Client Area) ---------
# Der Port, den du im AirVPN-Client-Area unter "Ports" angelegt hast.
FIREWALL_VPN_INPUT_PORTS=

# Aus der von AirVPN generierten .conf übernehmen:
WIREGUARD_PUBLIC_KEY=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=

# --- Variante B: ProtonVPN (dynamischer Port via NAT-PMP) -------------
# Statt FIREWALL_VPN_INPUT_PORTS die nächste Zeile aktivieren.
# Gluetun holt den Port dann selbst und meldet ihn an qBittorrent.
#VPN_PORT_FORWARDING=on

# Optionale Serverwahl. Vorsicht: kann bei manchen Anbietern den
# Verbindungsaufbau verhindern. Im Zweifel auskommentiert lassen.
#SERVER_COUNTRIES=Switzerland
#SERVER_CITIES=

# Gluetun bringt einen eigenen DNS-Resolver (unbound) mit, dessen Cache
# über Wochen auf mehrere GB wachsen kann. Auf einer 24/7-Kiste abschalten.
BLOCK_MALICIOUS=off

# Gibt dem Tunnel beim Start mehr Zeit, bevor der Healthcheck greift.
HEALTH_VPN_DURATION_INITIAL=120s

# ---------------------------------------------------------------------
# Feste IPs im servarrnetwork
# ---------------------------------------------------------------------
SET_IP_GLUETUN=172.39.0.2
SET_IP_SONARR=172.39.0.3
SET_IP_RADARR=172.39.0.4
SET_IP_LIDARR=172.39.0.5
SET_IP_BAZARR=172.39.0.6
SET_IP_SEERR=172.39.0.7
SET_IP_JELLYFIN=172.39.0.8

# ---------------------------------------------------------------------
# Jellyfin
# ---------------------------------------------------------------------
# IP oder Hostname, unter dem Clients den Server erreichen.
JELLYFIN_URL=http://192.168.178.x:8096
